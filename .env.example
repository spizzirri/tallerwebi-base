# Read by `docker compose` only. The application does not load this file: when you run
# `mvn jetty:run` on the host, it reads DB_* from the process environment, not from here.
#
# That difference matters for the host. APP_DB_HOST below is the name Compose gives the
# postgres service on the docker network, and it is the only key here Compose reads. A
# host-side JVM must not use it: that JVM needs `localhost`, which is already the app's
# built-in default (EnvironmentConfig.DEFAULT_DB_HOST), so leave DB_HOST unset there.

POSTGRES_DB=valhalla
POSTGRES_USER=user
POSTGRES_PASSWORD=user

# Database
# APP_DB_HOST is Compose-side only: it names the postgres service on the docker network.
# The app inside the container still receives this as DB_HOST. On the host, do not set
# DB_HOST from this file -- the app already defaults to localhost.
APP_DB_HOST=postgres
DB_PORT=5432
DB_NAME=valhalla
DB_USER=user
DB_PASSWORD=user

# Spring Security
SECURITY_SECRET=mySecretKeyForCSRFAtLeast32CharactersLong!

# Server
SERVER_PORT=8080

# Invitations: leave SMTP_HOST empty to keep invitations in Mis planes without sending mail.
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=planit@localhost
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
