# Copiar a .env y completar (no commitear .env)

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tallerwebi
MYSQL_USER=user
MYSQL_PASSWORD=user

# Jetty en tu PC: localhost. App en Docker Compose: mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tallerwebi
DB_USER=user
DB_PASSWORD=user

# Google AI Studio — usar GEMINI_API_KEY o GOOGLE_API_KEY
GEMINI_API_KEY=

