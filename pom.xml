<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.valhalla</groupId>
    <artifactId>valhalla</artifactId>
    <packaging>war</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>spring web mvc</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jdk.version>25</jdk.version>
        <!-- HTTP port for E2E: Jetty and Playwright both read this. Failsafe derives
             e2e.baseUrl from it, so -Djetty.port=9090 moves the server and the tests together. -->
        <jetty.port>8080</jetty.port>
        <spring.version>6.2.19</spring.version>
        <servletapi.version>6.0.0</servletapi.version>
        <thymeleaf.spring.version>3.1.5.RELEASE</thymeleaf.spring.version>
        <hamcrest.version>2.2</hamcrest.version>
        <junit.version>6.1.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <hibernate.version>6.6.54.Final</hibernate.version>
        <springdata.version>3.5.13</springdata.version>
        <playwright.version>1.61.0</playwright.version>
        <hsqldb.version>2.7.4</hsqldb.version>
        <checkstyle.version>3.6.0</checkstyle.version>
        <checkstyle.runtime.version>13.8.0</checkstyle.runtime.version>
        <!-- Whether jacoco:check enforces the coverage thresholds. Its rules are written
             for the whole suite (bundle at least 0.80 line, domain 1.00 line and branch,
             presentation 1.00 line), but the goal sits in the test phase, which every
             surefire run passes through. A run of a single layer therefore measured only
             that layer and failed the build with all of its own tests green. gate.ps1 sets
             this to true for unit, integration, e2e and all with a target; only a bare
             `all` executes everything the thresholds assume. Not jacoco.skip: that one
             also disarms prepare-agent and the report, and would cost the coverage
             matrix. -->
        <jacoco.gate.skip>false</jacoco.gate.skip>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <dependency>
            <groupId>org.hsqldb</groupId>
            <artifactId>hsqldb</artifactId>
            <version>${hsqldb.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>

        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf-spring6</artifactId>
            <version>${thymeleaf.spring.version}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servletapi.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>${hamcrest.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- Spring Data JPA: repositorios basados en interfaces (sin Spring Boot) -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
            <version>${springdata.version}</version>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Password encryption with BCrypt -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>6.5.11</version>
        </dependency>

        <!-- Spring Security Web + Config -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
            <version>6.5.11</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
            <version>6.5.11</version>
        </dependency>

        <!-- Thymeleaf Spring Security dialect -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
            <version>3.1.5.RELEASE</version>
        </dependency>

        <!-- Spring Security test support -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <version>6.5.11</version>
            <scope>test</scope>
        </dependency>

        <!-- Form validation with Bean Validation (Jakarta) -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.5.Final</version>
        </dependency>

        <!-- EL implementation required by Hibernate Validator to interpolate messages -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>4.0.2</version>
        </dependency>
    </dependencies>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${jdk.version}</release>
                    <showDeprecation>true</showDeprecation>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>1000</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Plugin to run the tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>

                <configuration>
                    <!-- Unit + integration tests (everything except E2E) -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                    <!-- Load Mockito as a real agent so it stops self-attaching and
                         stops warning about dynamic agent loading. @{argLine} keeps
                         the JaCoCo agent injected by prepare-agent. -->
                    <argLine>@{argLine} -Xshare:off -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>

            <!-- E2E tests: runs after jetty starts, before it stops -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- *E2E.java only: **/e2e/** also matched views/*.java and ResetDatabase -->
                    <includes>
                        <include>**/e2e/*E2E.java</include>
                    </includes>
                    <!-- No JaCoCo here on purpose: these tests drive the app through a real
                         browser against the Jetty process, and the code under test runs in
                         Jetty's JVM (not in this failsafe fork), so an agent on argLine
                         would only measure Playwright driver calls, never the app. E2E
                         contributes flow validation, not coverage; the coverage number is
                         unit+integration only (see the jacoco report execution). -->
                    <!-- fail the build when the include pattern matches nothing, instead of
                         reporting BUILD SUCCESS for zero tests -->
                    <failIfNoTests>true</failIfNoTests>
                    <!-- tests follow the server: -Djetty.port=9090 moves Jetty and Playwright -->
                    <systemPropertyVariables>
                        <e2e.baseUrl>http://localhost:${jetty.port}</e2e.baseUrl>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.hubspot.maven.plugins</groupId>
                <artifactId>prettier-maven-plugin</artifactId>
                <version>0.22</version>
                <configuration>
                    <!-- Prettier-Java documentation: https://github.com/jhipster/prettier-java -->
                    <prettierJavaVersion>2.5.0</prettierJavaVersion>
                    <!-- Maximum line length (100) aligned with Google Checkstyle -->
                    <printWidth>100</printWidth>
                </configuration>
                <executions>
                    <execution>
                        <id>format-check</id>
                        <!-- Verifies formatting without touching files: a build must never rewrite
                             the working tree. Format explicitly with `gate.ps1 check -Fix`
                             (or `mvn prettier:write`). -->
                        <phase>process-sources</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.version}</version>
                <dependencies>
                    <!-- Checkstyle runtime version (Java 25 / JEP 512 support) -->
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.runtime.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Location of the custom config file (Google Style based but Prettier-friendly) -->
                    <configLocation>${project.basedir}/checkstyle-base.xml</configLocation>
                    <!-- Print style rule violations directly to the console -->
                    <consoleOutput>true</consoleOutput>
                    <!-- Fail the build on any style rule violation -->
                    <failsOnError>true</failsOnError>
                    <!-- Skip XRef links (keeps detailed HTML reports sane) -->
                    <linkXRef>false</linkXRef>
                    <!-- Directory where the visual reports (HTML) are generated -->
                    <outputDirectory>${project.basedir}/.code-quality/checkstyle</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <!-- Unique identifier for this plugin execution -->
                        <id>validate</id>
                        <!-- Maven lifecycle phase in which it runs (initial validation) -->
                        <phase>validate</phase>
                        <goals>
                            <!-- Runs the style check. If it fails, the build stops per the config above -->
                            <goal>check</goal>
                            <!-- Generates the visual report (HTML) during validation -->
                            <goal>checkstyle</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>checkstyle-report</id>
                        <!-- Lifecycle phase to generate reports during tests -->
                        <phase>test</phase>
                        <goals>
                            <goal>checkstyle</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <!-- Print rule violations directly on the Maven console -->
                    <printFailingErrors>true</printFailingErrors>
                    <!-- Skip XRef links (code cross references) -->
                    <linkXRef>false</linkXRef>
                    <rulesets>
                        <!-- Rule sets to apply (standard and custom) -->
                        <ruleset>/category/java/bestpractices.xml</ruleset>
                        <ruleset>/category/java/errorprone.xml</ruleset>
                        <ruleset>${project.basedir}/pmd-code-rules.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <!-- Unified PMD execution (rule analysis) -->
                    <execution>
                        <!-- Unique identifier for this execution -->
                        <id>pmd-all</id>
                        <!-- Maven lifecycle phase in which it runs (initial validation) -->
                        <phase>validate</phase>
                        <goals>
                            <!-- Generates the PMD report (required for the check) -->
                            <goal>pmd</goal>
                            <!-- Validates results against the defined rules and fails on violations -->
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Directory for the results XML file used by the validation -->
                            <targetDirectory>${project.basedir}/.code-quality/pmd</targetDirectory>
                            <!-- Directory for the visual reports (HTML) and their assets (CSS/images) -->
                            <outputDirectory>${project.basedir}/.code-quality/pmd</outputDirectory>
                        </configuration>
                    </execution>

                    <!-- Unified CPD execution (duplicate detection) -->
                    <execution>
                        <!-- Unique identifier for this execution -->
                        <id>cpd-all</id>
                        <!-- Maven lifecycle phase in which it runs (initial validation) -->
                        <phase>validate</phase>
                        <goals>
                            <!-- Generates the CPD duplicate report -->
                            <goal>cpd</goal>
                            <!-- Validates found duplicates and fails above the threshold -->
                            <goal>cpd-check</goal>
                        </goals>
                        <configuration>
                            <!-- Directory for the duplicates XML file used by the validation -->
                            <targetDirectory>${project.basedir}/.code-quality/cpd</targetDirectory>
                            <!-- Directory for the visual duplicates reports (HTML) -->
                            <outputDirectory>${project.basedir}/.code-quality/cpd</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pmd-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>pmd</goal>
                        </goals>
                        <configuration>
                            <!-- Results XML directory for the test phase -->
                            <targetDirectory>${project.basedir}/.code-quality/pmd</targetDirectory>
                            <!-- HTML reports directory for the test phase -->
                            <outputDirectory>${project.basedir}/.code-quality/pmd</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cpd-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>cpd</goal>
                        </goals>
                        <configuration>
                            <!-- Duplicates results XML directory for the test phase -->
                            <targetDirectory>${project.basedir}/.code-quality/cpd</targetDirectory>
                            <!-- Duplicates HTML reports directory for the test phase -->
                            <outputDirectory>${project.basedir}/.code-quality/cpd</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <!-- Shared exclusions (report and check): config wiring and the servlet
                         initializer carry no business logic, and the DTOs are pure value
                         holders (constructors/getters/setters) whose coverage would only
                         pad the numbers. The JPA entities are deliberately NOT excluded:
                         Plan (isAdministrator, isParticipant, updateFrom, getIsPublic) and
                         User (activate) hold real behaviour the gate has to measure. -->
                    <excludes>
                        <exclude>com/valhalla/config/*</exclude>
                        <exclude>com/valhalla/MyServletInitializer.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanRequest.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanPlaceRequest.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanPlaceUpdateRequest.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanRestController$PlanSummary.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanRestController$PlanPlaceSummary.class</exclude>
                        <exclude>com/valhalla/presentation/plan/PlanPlaceRestController$ItineraryEntry.class</exclude>
                        <exclude>com/valhalla/presentation/user/*Request.class</exclude>
                        <exclude>com/valhalla/presentation/shared/*Request.class</exclude>
                        <exclude>com/valhalla/presentation/shared/UserSession.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <!-- Preparation phase: configures the JaCoCo agent to hook into the JVM test process -->
                        <goals>
                            <!-- Prepares the agent to collect coverage data during test runs -->
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Binary file where the collected execution data is stored -->
                            <destFile>${project.basedir}/.code-quality/jacoco/jacoco.exec</destFile>
                            <!-- Replace, don't append. With the default (true) the agent appends
                                 to whatever the previous run left behind, so a local `mvn test`
                                 could pass the gate on coverage measured in an older run that
                                 included lines since deleted. Safe because surefire forks once
                                 (forkCount=1): one JVM replaces the file once. -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <!-- Phase where the binary data is processed into readable reports -->
                        <!-- Bound to `test`, so this report covers ONLY surefire (unit +
                             integration). The browser E2E suite runs later in `integration-test`
                             (failsafe) and is deliberately not folded in: the app under test
                             executes inside the Jetty JVM, which prepare-agent does not
                             instrument (it only arms the surefire fork). So the CSV/HTML here
                             are unit+integration numbers; do not read them as end-to-end
                             coverage. -->
                        <phase>test</phase>
                        <goals>
                            <!-- Generates the coverage report (HTML, XML, CSV) -->
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <!-- Output directory for the HTML report -->
                            <outputDirectory>${project.basedir}/.code-quality/jacoco</outputDirectory>
                            <!-- Input data file generated by prepare-agent -->
                            <dataFile>${project.basedir}/.code-quality/jacoco/jacoco.exec</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <!-- Threshold validation: runs in the 'test' phase to fail the build when rules are not met -->
                        <phase>test</phase>
                        <goals>
                            <!-- Verifies coverage meets the defined minimum limits -->
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Gate toggle, see jacoco.gate.skip in <properties>. Written
                                 here as explicit configuration because the goal's own user
                                 property is jacoco.skip, which prepare-agent and the report
                                 share: setting that to skip the gate would skip the report
                                 with it. -->
                            <skip>${jacoco.gate.skip}</skip>
                            <!-- Data file to validate -->
                            <dataFile>${project.basedir}/.code-quality/jacoco/jacoco.exec</dataFile>
                            <rules>
                                <!-- Business logic must be fully covered (domain). Domain holds the
                                     access-check predicates (Plan.isAdministrator/isParticipant,
                                     getIsPublic) and the value rules, so LINE and BRANCH are both
                                     pinned at 100%: a line-only rule lets a dead disjunct pass, and
                                     these disjuncts are exactly what the clone access-check runs. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <!-- The trailing .* is load-bearing. JaCoCo matches PACKAGE
                                             names exactly, and there is no com.valhalla.domain:
                                             the code lives in .plan, .user, .place and friends.
                                             Without the wildcard this rule evaluated nothing and
                                             every build reported "All coverage checks have been
                                             met" while domain sat untested. The bare package
                                             spelling sits alongside the wildcard for the same
                                             reason infrastructure carries both: a class dropped
                                             straight into com.valhalla.domain (no subpackage)
                                             would otherwise escape the 100% rule entirely. -->
                                        <include>com.valhalla.domain</include>
                                        <include>com.valhalla.domain.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Presentation is fully line-covered but not branch-pinned: its
                                     missed branches are structural validation ternaries (null form
                                     fields, default visibility), not access decisions. Pinning BRANCH
                                     here would force tests on defensive wiring while the real access
                                     logic lives in domain and infrastructure.plan, which carry their
                                     own branch rules. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.valhalla.presentation</include>
                                        <include>com.valhalla.presentation.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Persistence glue requires high but not exhaustive coverage. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <!-- Same trap as the wildcard above, mirrored: the plain
                                             package name only matches com.valhalla.infrastructure
                                             itself (the seeders). Every subpackage (.web,
                                             .security, .plan) is left out of the rule, so a
                                             package could sit under 80% forever without failing
                                             the build. Both spellings are needed: the wildcard
                                             does not match the package it is attached to. -->
                                        <include>com.valhalla.infrastructure</include>
                                        <include>com.valhalla.infrastructure.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Global safety net so future packages cannot silently go untested. -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>12.0.37</version>
                <configuration>
                    <httpConnector>
                        <port>${jetty.port}</port>
                    </httpConnector>
                    <scan>-1</scan>
                    <webApp>
                        <contextPath>/</contextPath>
                    </webApp>
                    <stopPort>8079</stopPort>
                    <stopKey>stop</stopKey>
                </configuration>
                <executions>
                    <execution>
                        <id>start-jetty</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>stop-jetty</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>

        </plugins>

        <pluginManagement>
            <plugins>
                <!-- This config silences IDE (m2e) warnings about plugin executions
                     it does not recognize in its internal lifecycle -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-pmd-plugin</artifactId>
                                        <versionRange>[3.0.0,)</versionRange>
                                        <goals>
                                            <goal>pmd</goal>
                                            <goal>check</goal>
                                            <goal>cpd</goal>
                                            <goal>cpd-check</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-checkstyle-plugin</artifactId>
                                        <versionRange>[3.0.0,)</versionRange>
                                        <goals>
                                            <goal>check</goal>
                                            <goal>checkstyle</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.jacoco</groupId>
                                        <artifactId>jacoco-maven-plugin</artifactId>
                                        <versionRange>[0.8.0,)</versionRange>
                                        <goals>
                                            <goal>prepare-agent</goal>
                                            <goal>report</goal>
                                            <goal>check</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>com.hubspot.maven.plugins</groupId>
                                        <artifactId>prettier-maven-plugin</artifactId>
                                        <versionRange>[0.0.1,)</versionRange>
                                        <goals>
                                            <goal>write</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <checkstyle.skip>true</checkstyle.skip>
                <pmd.skip>true</pmd.skip>
                <cpd.skip>true</cpd.skip>
                <prettier.skip>true</prettier.skip>
                <jacoco.skip>true</jacoco.skip>
                <!-- jacoco.skip alone no longer reaches the check goal: the check-coverage
                     execution spells its skip out as ${jacoco.gate.skip}, and an explicit
                     configuration wins over the goal's user property. Without this line
                     -Fast would skip the agent and the report but still evaluate the gate
                     against a report that was never written, which fails on a clean clone. -->
                <jacoco.gate.skip>true</jacoco.gate.skip>
            </properties>
        </profile>
    </profiles>

</project>




