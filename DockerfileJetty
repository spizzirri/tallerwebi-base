FROM eclipse-temurin:21-jdk

ENV JETTY_VERSION=12.0.14
ENV JETTY_HOME=/opt/jetty

RUN apt-get update && apt-get install -y wget && \
    mkdir -p $JETTY_HOME && \
    wget https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-ee10-distribution/${JETTY_VERSION}/jetty-ee10-distribution-${JETTY_VERSION}.tar.gz -O jetty.tar.gz && \
    tar -xzvf jetty.tar.gz -C $JETTY_HOME --strip-components=1 && \
    rm jetty.tar.gz

COPY target/tallerwebi-base-1.0-SNAPSHOT.war $JETTY_HOME/webapps/spring.war

EXPOSE 8080

WORKDIR $JETTY_HOME

CMD ["java", "-jar", "./start.jar"]
